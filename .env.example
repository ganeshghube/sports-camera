# ---- AI ball tracker ----
RTSP_URL=
MODEL_PATH=models/best.pt
DEVICE=AUTO            # AUTO | GPU | CPU
CONFIDENCE=0.25
INPUT_SIZE=640         # detection resolution
DISPLAY_WIDTH=0        # display-only resize (0 = native)
SHOW_DEBUG_WINDOW=false
SHOW_DEBUG_OVERLAY=false
INFERENCE_EVERY_N_FRAMES=1

# ---- ESP32 pan/tilt (off by default) ----
USE_SERIAL=false
SERIAL_PORT=COM5
SERIAL_BAUDRATE=115200

# ---- Backend link ----
BACKEND_WS_URL=ws://127.0.0.1:8000/ws/ball-tracking

# ---- Live preview frames sent to the web UI (reuses the tracker's decoded frame) ----
PREVIEW_STREAM=true
PREVIEW_WIDTH=640
PREVIEW_FPS=8
PREVIEW_QUALITY=60

# ---- Backend server ----
HOST=0.0.0.0           # LAN bind address; browser uses the device's actual IP
PORT=8000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin        # used only on FIRST run to create the user; if blank a random one is printed
# DB_PATH=data/cricket.db
# RECORDINGS_DIR=recordings
# PUBLIC_URL=                 # optional; otherwise derived from the request host

# ---- YouTube OAuth (optional) — Google Cloud Console -> OAuth client (Web) ----
# Redirect URI to register exactly in Google Cloud OAuth client.
# For local use: http://127.0.0.1:8000/api/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/youtube/callback

# ---- Facebook OAuth (optional) — developers.facebook.com -> App ----
# Redirect URI to register: http://localhost:8000/api/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Exact Live Preview -> YouTube renderer
# Leave blank to auto-detect Chrome/Edge.
CRICKET_CHROME_PATH=
BROADCAST_BROWSER_FPS=30

# --- Live broadcast / YouTube quality ---
YOUTUBE_LATENCY=ultraLow
YOUTUBE_RESOLUTION=1080p
YOUTUBE_FPS=60
YOUTUBE_BITRATE_K=17000
YOUTUBE_AUDIO_BITRATE_K=128
STREAM_X264_PRESET=veryfast
RECORD_X264_PRESET=veryfast
# Browser executable is auto-detected on Windows/Linux. Optional:
# CRICKET_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Realtime AI / camera ---
PUBLISH_INTERVAL=0.05
PREVIEW_FPS=20
PREVIEW_WIDTH=1280
PREVIEW_QUALITY=72
TRACK_SMOOTHING=0.35
PREDICTION_SECONDS=0.06
MAX_PREDICTION_PX=220

# --- Raspberry Pi STEP/DIR motor mount (optional) ---
# MOTOR_DRIVER=none | serial | gpio
MOTOR_DRIVER=none
PAN_STEP_PIN=17
PAN_DIR_PIN=27
TILT_STEP_PIN=22
TILT_DIR_PIN=23
GPIO_MAX_PAN_SPS=700
GPIO_MAX_TILT_SPS=550

# --- Automatic GitHub release updates ---
# Example: GITHUB_REPO=your-org/cricket-live
GITHUB_REPO=ganeshghube/sports-camera
GITHUB_BRANCH=main
# Optional for private repositories:
GITHUB_TOKEN=
# Optional exact release asset name:
GITHUB_UPDATE_ASSET=


# --- Tracking performance / motor safety ---
AUTO_CAMERA_TRACK=true
MIN_TRACK_CONFIDENCE=0.35
AI_MAX_FPS=20
